APP_NAME="Ruang Dokumen"
DATA_DIR=./data
SQLITE_FILENAME=app.db
CHROMA_COLLECTION=agent_documents

DEFAULT_CHAT_PROVIDER=litellm
LITELLM_MODEL=ollama_chat/llama3.1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LITELLM_API_KEY=

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=4
# Starting value only: calibrate against positive and negative questions before demo.
SIMILARITY_THRESHOLD=0.80
MAX_UPLOAD_MB=20
PROVIDER_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
