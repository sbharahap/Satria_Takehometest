APP_NAME="Ruang Dokumen"
DATA_DIR=./data
SQLITE_FILENAME=app.db
CHROMA_COLLECTION=agent_documents

DEFAULT_CHAT_PROVIDER=litellm
LITELLM_MODEL=ollama_chat/qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_FREE_ONLY=true
OPENROUTER_REASONING_ENABLED=false
# One local retry when OpenRouter fails; never routes to a paid API.
LOCAL_FALLBACK_ENABLED=true
# Best-effort local semantic check for ANSWER_MODE=abstractive only.
CITATION_VERIFIER_ENABLED=true
# Extractive: model selects literal evidence; abstractive: free text + best-effort LLM verifier.
ANSWER_MODE=extractive
LOCAL_FALLBACK_MODEL=ollama_chat/qwen3:8b
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LITELLM_API_KEY=

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=4
# Initial PT XYZ/regulation smoke calibration; evaluate for other documents/embeddings.
SIMILARITY_THRESHOLD=0.82
MAX_UPLOAD_MB=20
PROVIDER_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO

# Local OCR for scanned PDF pages (Docker includes both engines and language packs).
OCR_ENABLED=true
OCR_MAX_PAGES=40
# OCR_TESSDATA_DIR=/absolute/path/to/tessdata
